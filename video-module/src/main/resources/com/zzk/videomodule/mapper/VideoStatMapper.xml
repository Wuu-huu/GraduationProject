            <result property="shareCount" column="share_count" />
            <result property="commentCount" column="comment_count" />
            <result property="danmuCount" column="danmu_count" />
            <result property="avgWatchSec" column="avg_watch_sec" />
            <result property="avgCompletionRate" column="avg_completion_rate" />
            <result property="hotScore" column="hot_score" />
            <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="Base_Column_List">
        vid,exposure_count,play_count,like_count,dislike_count,coin_count,
        favorite_count,share_count,comment_count,danmu_count,avg_watch_sec,
        avg_completion_rate,hot_score,update_time
