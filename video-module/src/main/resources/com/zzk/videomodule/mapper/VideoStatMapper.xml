<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzk.videomodule.mapper.VideoStatMapper">

    <resultMap id="BaseResultMap" type="com.zzk.videomodule.entity.VideoStat">
            <id property="vid" column="vid" />
